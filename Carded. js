        // إدارة القائمة الجانبية (Sidebar)
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const isOpen = !sidebar.classList.contains('translate-x-full');

            if (isOpen) {
                sidebar.classList.add('translate-x-full');
                overlay.classList.add('opacity-0', 'pointer-events-none');
            } else {
                sidebar.classList.remove('translate-x-full');
                overlay.classList.remove('opacity-0', 'pointer-events-none');
            }
        }

        // إدارة النوافذ المنبثقة (Modals)
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('opacity-0', 'pointer-events-none');
            }
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('opacity-0', 'pointer-events-none');
            }
        }

        // إرسال نموذج اتصل بنا عبر AJAX مع إشعار بالنجاح
        async function handleContactSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('contactSubmitBtn');
            const btnText = document.getElementById('contactBtnText');
            const status = document.getElementById('contactStatus');

            btn.disabled = true;
            btnText.textContent = "جاري الإرسال...";

            const payload = {
                name: document.getElementById('contactName').value,
                email: document.getElementById('contactEmail').value,
                subject: document.getElementById('contactSubject').value,
                message: document.getElementById('contactMessage').value,
                _captcha: "false"
            };

            try {
                const res = await fetch("https://formsubmit.co/ajax/sh.k.b1448@gmail.com", {
                    method: "POST",
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    status.innerHTML = "✅ تم إرسال رسالتكم بنجاح إلى إدارة الموسوعة، جزاكم الله خيراً.";
                    status.className = "text-center p-3 rounded-xl text-xs font-bold bg-emerald-100 text-emerald-900 border border-emerald-300";
                    document.getElementById('contactForm').reset();
                } else {
                    throw new Error();
                }
            } catch (err) {
                status.innerHTML = "⚠️ حدث خطأ في الاتصال، يرجى المحاولة مرة أخرى.";
                status.className = "text-center p-3 rounded-xl text-xs font-bold bg-rose-100 text-rose-900 border border-rose-300";
            } finally {
                btn.disabled = false;
                btnText.textContent = "إرسال الرسالة إلى إدارة الموسوعة";
                status.classList.remove('hidden');
            }
        }

        // ملء قائمة الأمراض الفريدة
        function populateDiseases() {
            const select = document.getElementById('diseaseFilter');
            const set = new Set();
            allCards.forEach(card => {
                if (card.diseases_and_symptoms) {
                    card.diseases_and_symptoms.forEach(d => set.add(d));
                }
            });
            Array.from(set).sort().forEach(disease => {
                const opt = document.createElement('option');
                opt.value = disease;
                opt.textContent = disease;
                select.appendChild(opt);
            });
        }

