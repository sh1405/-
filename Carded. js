            const shareData = {
                title: card.title,
                text: `📌 [${card.title}]\n«${card.hadith_verbatim}»\n📖 المصدر: ${card.primary_source} (رقم: ${card.hadith_number})\n\nمن: الموسوعة الجامعة للهدي والصحة النبوية`,
